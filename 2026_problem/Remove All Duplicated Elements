# Problem: Remove All Duplicated Elements
# Given a list lst, return a new list containing only the elements that
# appear exactly once. Any element that occurs more than once is removed
# entirely (not just reduced to a single copy). Original order is kept.
# ─────────────────────────────────────────
# Solved by: counting frequencies with Counter, then collecting the
# elements whose count is 1. Counter preserves first-seen order
# (Python 3.7+), so the result keeps the original ordering.
# Time: O(n)  Space: O(n)

from collections import Counter

def remove_duplicates(lst):
    count = Counter(lst)
    result = []

    for x in count:
        if count[x] == 1:
            result.append(x)

    return result

# lst = [1, 2, 2, 3, 4, 4, 5]  -> [1, 3, 5]
# lst = [7, 7, 7]              -> []
# lst = [1, 2, 3]              -> [1, 2, 3]
